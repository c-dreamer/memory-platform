<?xml version="1.0" encoding="UTF-16"?>
<!--
  Windows Task Scheduler analog of launchd/com.memory-platform.full-recovery.plist.template
  (decision #22, docs/WINDOWS_PORT_SYNTHESIS.md). Manual/opt-in recovery worker,
  same as on macOS: install-taskscheduler.ps1 only registers this with
  -IncludeFullRecovery, and it is always skipped under MEMORY_LOCAL_ONLY=1
  (decision #23: it has nothing to do without Neon).
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Memory Platform: manual full Neon recovery worker, run at logon (mirrors com.memory-platform.full-recovery on macOS).</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USER__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>__POWERSHELL__</Command>
      <Arguments>__PS1_ARGS__</Arguments>
    </Exec>
  </Actions>
</Task>
