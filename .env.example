# ============================================================
# Memory Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# All variables match the Python config.py + docker-compose.memory.yml.

# --- Local-only mode ---
# Optional, default off (like REDIS_URL/NEO4J_URI). When true, this device
# must never reach the network except the OneDrive/Drive cold-storage archive.
# Config::from_env() refuses to start if EMBEDDING_MODEL isn't "llama-cpp" (the
# genuinely offline backend) or any of NVIDIA_API_KEY/OPENAI_API_KEY/OBSIDIAN_API_KEY
# is set. neon-sync and
# memory-dashboard also refuse to run/dial Neon under this flag.
MEMORY_LOCAL_ONLY=

# --- Database ---
DATABASE_URL=postgresql://memory:password@127.0.0.1:5432/memory
MEMORY_DEVICE_ID=replace-with-a-stable-per-device-id
NEON_URL=
NEON_DATABASE_URL=
# Direct (non-pooled) endpoint for the single serialized synchronizer —
# any Postgres-compatible database with pgvector works here: Neon, Supabase,
# or a self-hosted VPS. Do not use a connection-pooler hostname/port (Neon's
# "-pooler" hostnames, Supabase's pooler hostnames/port 6543, PgBouncer's
# usual port 6432 are all rejected at startup).
# SYNC_TARGET_URL is the provider-neutral name; NEON_SYNC_URL/NEON_DIRECT
# are accepted too, for existing setups.
SYNC_TARGET_URL=
NEON_SYNC_URL=
# REDIS_URL/NEO4J_URI below use docker-compose service hostnames and only
# resolve when running via docker-compose.yml with Docker Desktop. On a box
# without Docker (the default on Windows here), leave both unset — both
# services are optional and the platform runs without them.
REDIS_URL=redis://memory-redis:6379/0
NEO4J_URI=bolt://memory-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- API ---
API_KEY=
API_PORT=8000

# --- Embeddings ---
# EMBEDDING_MODEL=nvidia uses the NVIDIA NIM API below. EMBEDDING_MODEL=llama-cpp
# talks to a local `llama-server` (llama.cpp) instance instead — no cloud call,
# no API key; see docs/WINDOWS_PORT_SYNTHESIS.md decision #1.
EMBEDDING_MODEL=nvidia
EMBEDDING_DIM=2048
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
OPENAI_API_KEY=
# llama-server's OpenAI-compatible embeddings endpoint, loopback only.
LLAMA_CPP_URL=http://127.0.0.1:8080/v1/embeddings
LLAMA_CPP_MODEL_NAME=qwen3-embedding-4b

# --- Obsidian ---
VAULT_PATH=/Users/REPLACE/Library/Mobile Documents/iCloud~md~obsidian/Documents/Main Vault
# Windows example: VAULT_PATH=C:\Users\REPLACE\Documents\Main Vault
# OBSIDIAN_API_URL below uses the docker-compose host-gateway alias; without
# Docker, point it at the Obsidian Local REST API plugin's actual host, e.g.
# http://127.0.0.1:27124
OBSIDIAN_API_URL=http://host.docker.internal:27124
OBSIDIAN_API_KEY=

# --- Cache TTLs (seconds) ---
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# --- Hybrid Search ---
SEARCH_DEFAULT_MODE=hybrid
RRF_K=20
RRF_VECTOR_WEIGHT=0.6
RRF_KEYWORD_WEIGHT=0.4

# --- Memory Decay (Ebbinghaus-inspired) ---
DECAY_ENABLED=true
DECAY_HALF_LIFE_DAYS=90.0
DECAY_MIN_SCORE=0.1
DECAY_APPLY_TO_SEARCH=true

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNKS_PER_DOC=100

# --- Cold Archive Encryption ---
# Opt-in (decision #18/#19, docs/WINDOWS_PORT_SYNTHESIS.md). ARCHIVE_ENCRYPT=1
# makes archive-documents.sh send only an age-encrypted bundle to Drive; the
# archive-crypt binary does the crypto. Recipient (public key) is required to
# encrypt; identity (private key file) is required to decrypt/restore.
# Key custody is unresolved: whether ARCHIVE_AGE_IDENTITY_FILE is placed by
# hand or fetched from Keeper Secrets Manager is still open (§8 Q3/Q4,
# docs/WINDOWS_PORT_SYNTHESIS.md) — KSM provisioning status on the Microtech
# Keeper tenant is unconfirmed, so this local-file path is what's wired today.
ARCHIVE_ENCRYPT=0
ARCHIVE_AGE_RECIPIENT=
ARCHIVE_AGE_IDENTITY_FILE=

# --- Logging ---
RUST_LOG=info
